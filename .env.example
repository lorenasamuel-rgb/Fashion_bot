# Copy to .env.local for local development. On Vercel, set the same names
# in Project Settings → Environment Variables. Never commit real values.

# Supabase project URL (server reads this to store sessions, lots, and messages)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase secret key. Server only. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# xAI key used by the Grok supplier bot. Without it, replies fall back to the rule engine.
XAI_API_KEY=
